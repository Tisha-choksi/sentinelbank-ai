# Copy this file to `.env` and fill in real values before running anything
# (docker compose, or the backend/frontend locally). `.env` is gitignored
# and must never be committed -- this file only ever holds placeholders.
#
# The values below are DEVELOPMENT-ONLY placeholders. Do not reuse them,
# or the demo account passwords in backend/db_seed.py, for any deployment
# reachable by anyone other than you on your own machine.

# --- PostgreSQL -------------------------------------------------------
# Used directly by the `db` container, and to build DATABASE_URL below.
POSTGRES_DB=sentinelbank
POSTGRES_USER=sentinelbank
POSTGRES_PASSWORD=change-me-dev-only

# --- Backend: local/non-Docker use ------------------------------------
# Read by backend/db.py and Alembic when running `uvicorn` or `alembic`
# directly on the host. Points at the host-mapped port (5433), NOT the
# Postgres container's internal port 5432.
# Inside Docker Compose, backend/migrate ignore this value and instead
# connect via the service name "db" on port 5432 -- see docker-compose.yml.
DATABASE_URL=postgresql+psycopg://sentinelbank:change-me-dev-only@127.0.0.1:5433/sentinelbank

# --- Auth ---------------------------------------------------------------
# Generate a real secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# Rotate this for any deployment beyond your own machine; anyone with it
# can mint valid access tokens for any user/role.
JWT_SECRET_KEY=change-me-dev-only-generate-a-real-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontend (Docker build-time only) ----------------------------------
# Baked into the browser JS bundle at `next build` time -- must be an
# address the user's BROWSER can reach (e.g. http://localhost:8000), never
# a Docker-only service name. Only needed if the API is published on a
# different host/port than the default used by docker-compose.yml.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- AI investigation (Ollama) -------------------------------------------
# Only needed inside Docker Compose (backend/llm_client.py's own default,
# 127.0.0.1:11434, would otherwise mean "this container", not your host).
# Ollama itself isn't containerized here -- install it on the host, or
# point this at wherever it actually runs.
# OLLAMA_HOST=http://host.docker.internal:11434
